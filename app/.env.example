# =====================================================================
# Copie este arquivo para .env e ajuste os valores.
#   cp .env.example .env
#
# O .env REAL nao e versionado (ver .gitignore na raiz do repositorio).
# Nenhuma credencial aparece no codigo-fonte: src/config.js le tudo
# daqui, e falha no boot se faltar alguma variavel obrigatoria.
# =====================================================================

# --- Servidor ---------------------------------------------------------
PORT=3000
# Chave de assinatura do cookie de sessao. Em uso real: valor aleatorio
# longo, diferente em cada ambiente.
SESSION_SECRET=troque-este-valor-em-producao

# --- Banco ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=escola_ucb

# --- Um usuario MySQL por perfil de acesso ----------------------------
# Os privilegios de cada um estao em sql/06_usuarios_perfis.sql.
# A aplicacao escolhe o pool pelo perfil de quem fez login, entao o
# limite vale mesmo que alguem contorne a interface.

# so autentica: le as colunas de login de usuario_app
DB_AUTH_USER=escola_auth
DB_AUTH_PASSWORD=dev_auth_2026

# operacao academica completa
DB_SECRETARIA_USER=escola_secretaria
DB_SECRETARIA_PASSWORD=dev_secretaria_2026

# lanca e corrige nota; le o resto
DB_PROFESSOR_USER=escola_professor
DB_PROFESSOR_PASSWORD=dev_professor_2026

# so as visoes, sem dado pessoal
DB_CONSULTA_USER=escola_consulta
DB_CONSULTA_PASSWORD=dev_consulta_2026

# =====================================================================
# Contas da aplicacao criadas por sql/06_usuarios_perfis.sql
# (senhas de demonstracao; o banco guarda so o hash bcrypt)
#
#   secretaria / secretaria123    perfil SECRETARIA
#   professor  / professor123     perfil PROFESSOR
#   consulta   / consulta123      perfil CONSULTA
# =====================================================================
