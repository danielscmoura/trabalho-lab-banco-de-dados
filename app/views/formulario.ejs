<%- include('_cabecalho') %>
<form method="post" action="/cadastros/<%= slug %><%= id ? '/' + id : '' %>" class="form-registro">
  <% ent.campos.forEach(function (c) {
       var v = registro[c.nome];
       var lista = c.dinamico ? (opcoes[c.nome] || []) : (c.opcoes || []); %>
    <label class="campo">
      <span><%= c.rotulo %><%= c.obrigatorio ? ' *' : '' %></span>
      <% if (c.tipo === 'select') { %>
        <select name="<%= c.nome %>" <%= c.obrigatorio ? 'required' : '' %>>
          <% lista.forEach(function (o) { %>
            <option value="<%= o[0] %>" <%= String(v == null ? '' : v) === String(o[0]) ? 'selected' : '' %>><%= o[1] %></option>
          <% }); %>
        </select>
      <% } else if (c.tipo === 'checkbox') { %>
        <input type="checkbox" name="<%= c.nome %>" <%= v ? 'checked' : '' %>>
      <% } else if (c.tipo === 'textarea') { %>
        <textarea name="<%= c.nome %>" rows="3"><%= v == null ? '' : v %></textarea>
      <% } else { %>
        <input type="<%= c.tipo %>" name="<%= c.nome %>" value="<%= v == null ? '' : v %>"
               <%= c.obrigatorio ? 'required' : '' %>>
      <% } %>
      <% if (c.ajuda) { %><small><%= c.ajuda %></small><% } %>
    </label>
  <% }); %>
  <div class="botoes">
    <button type="submit">Gravar</button>
    <a href="/cadastros/<%= slug %>">cancelar</a>
  </div>
</form>
<p class="nota">
  Os campos sao validados pelo banco, nao so pela tela. Se uma restricao da Etapa 1
  for violada, a mensagem que aparece aqui e a regra de negocio correspondente.
</p>
<%- include('_rodape') %>
